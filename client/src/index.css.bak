:root {
  color-scheme: dark;

  --bg-0: #0b0b10;
  --bg-1: #101017;
  --surface: #16161f;
  --surface-2: #1c1c28;
  --surface-hover: #22222f;
  --border: #2a2a38;
  --border-soft: #21212c;

  --text: #f2f2f6;
  --text-dim: #a3a3b2;
  --text-faint: #6c6c7c;

  --accent-1: #7c6cf0;
  --accent-2: #4f9dff;
  --accent-3: #d66bff;
  --accent-grad: linear-gradient(135deg, var(--accent-1), var(--accent-2));

  --danger: #ff6b6b;
  --danger-bg: rgba(255, 107, 107, 0.12);

  --radius-lg: 20px;
  --radius-md: 14px;
  --radius-sm: 10px;

  --shadow-soft: 0 8px 30px rgba(0, 0, 0, 0.35);
  --shadow-glow: 0 0 0 1px rgba(124, 108, 240, 0.25), 0 8px 24px rgba(124, 108, 240, 0.18);

  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

@media (prefers-color-scheme: light) {
  :root {
    color-scheme: light;
    --bg-0: #eef0f6;
    --bg-1: #f4f5fa;
    --surface: #ffffff;
    --surface-2: #f7f7fc;
    --surface-hover: #eeeef7;
    --border: #e2e2ee;
    --border-soft: #ececf5;

    --text: #17171f;
    --text-dim: #55556a;
    --text-faint: #8c8ca0;

    --shadow-soft: 0 8px 30px rgba(30, 30, 60, 0.1);
  }
}

* {
  box-sizing: border-box;
}

html,
body {
  height: 100%;
}

body {
  margin: 0;
  background: var(--bg-0);
  color: var(--text);
  overflow: hidden;
  position: relative;
}

/* Slowly drifting gradient blobs behind everything — subtle, premium feel
   without being distracting or costing much GPU. */
body::before,
body::after {
  content: "";
  position: fixed;
  width: 60vmax;
  height: 60vmax;
  border-radius: 50%;
  filter: blur(110px);
  opacity: 0.22;
  z-index: 0;
  pointer-events: none;
}

body::before {
  background: var(--accent-1);
  top: -20vmax;
  left: -15vmax;
  animation: float-a 26s ease-in-out infinite alternate;
}

body::after {
  background: var(--accent-2);
  bottom: -25vmax;
  right: -15vmax;
  animation: float-b 30s ease-in-out infinite alternate;
}

@keyframes float-a {
  0% {
    transform: translate(0, 0) scale(1);
  }
  100% {
    transform: translate(6vmax, 8vmax) scale(1.15);
  }
}

@keyframes float-b {
  0% {
    transform: translate(0, 0) scale(1);
  }
  100% {
    transform: translate(-6vmax, -6vmax) scale(1.1);
  }
}

@media (prefers-reduced-motion: reduce) {
  body::before,
  body::after {
    animation: none;
  }
}

/* ---------- Layout shell ---------- */

.app-shell {
  position: relative;
  z-index: 1;
  display: flex;
  height: 100vh;
}

/* ---------- Sidebar ---------- */

.sidebar {
  width: 280px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg-1);
  border-right: 1px solid var(--border-soft);
  position: fixed;
  top: 0;
  left: 0;
  height: 100%;
  transform: translateX(-100%);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  z-index: 40;
}

.sidebar.open {
  transform: translateX(0);
}

.sidebar-scrim {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 35;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.sidebar-scrim.visible {
  display: block;
  opacity: 1;
}

.sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 16px 14px;
  border-bottom: 1px solid var(--border-soft);
}

.sidebar-title {
  font-family: "Sora", "Inter", sans-serif;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: 0.01em;
  color: var(--text-dim);
  text-transform: uppercase;
  font-size: 12px;
}

.new-chat-button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--accent-grad);
  color: white;
  border: none;
  border-radius: 999px;
  padding: 7px 14px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
}

.new-chat-button:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-glow);
  filter: brightness(1.08);
}

.new-chat-button:active {
  transform: translateY(0);
}

.plus-icon {
  font-size: 15px;
  line-height: 1;
}

.sidebar-list {
  flex: 1;
  overflow-y: auto;
  padding: 10px 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sidebar-empty {
  color: var(--text-faint);
  font-size: 13px;
  padding: 16px 10px;
  text-align: center;
}

.sidebar-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  text-align: left;
  background: transparent;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  padding: 10px 10px;
  cursor: pointer;
  color: var(--text);
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}

.sidebar-item:hover {
  background: var(--surface-hover);
}

.sidebar-item.active {
  background: var(--surface-2);
  border-color: var(--border);
}

.sidebar-item.active .sidebar-item-dot {
  background: var(--accent-grad);
  box-shadow: 0 0 0 3px rgba(124, 108, 240, 0.18);
}

.sidebar-item-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--text-faint);
  flex-shrink: 0;
}

.sidebar-item-body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.sidebar-item-title {
  font-size: 13.5px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sidebar-item-meta {
  font-size: 11.5px;
  color: var(--text-faint);
}

.sidebar-footer {
  padding: 12px 16px;
  font-size: 11px;
  color: var(--text-faint);
  border-top: 1px solid var(--border-soft);
}

@media (min-width: 900px) {
  .sidebar {
    position: relative;
    transform: none !important;
  }
  .sidebar-scrim {
    display: none !important;
  }
  .sidebar-toggle {
    display: none;
  }
}

/* ---------- Chat window ---------- */

.chat-window {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  height: 100vh;
  position: relative;
}

.chat-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 22px;
  border-bottom: 1px solid var(--border-soft);
  background: color-mix(in srgb, var(--bg-1) 70%, transparent);
  backdrop-filter: blur(12px);
}

.sidebar-toggle {
  background: transparent;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
}

.hamburger,
.hamburger::before,
.hamburger::after {
  content: "";
  display: block;
  width: 16px;
  height: 2px;
  background: var(--text-dim);
  border-radius: 2px;
}

.hamburger {
  position: relative;
}

.hamburger::before {
  position: absolute;
  top: -5px;
}

.hamburger::after {
  position: absolute;
  top: 5px;
}

.chat-header-title {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  min-width: 0;
}

.chat-header-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #3ddc84;
  box-shadow: 0 0 0 3px rgba(61, 220, 132, 0.18);
  flex-shrink: 0;
  animation: pulse-dot 2.4s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%,
  100% {
    box-shadow: 0 0 0 3px rgba(61, 220, 132, 0.18);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(61, 220, 132, 0.08);
  }
}

.chat-header h1 {
  font-family: "Sora", "Inter", sans-serif;
  font-size: 16.5px;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.reset-button {
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 999px;
  padding: 8px 16px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  transition: background 0.15s ease, transform 0.1s ease;
  flex-shrink: 0;
}

.reset-button:hover:not(:disabled) {
  background: var(--surface-hover);
  transform: translateY(-1px);
}

.reset-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 24px 18px 12px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  scroll-behavior: smooth;
}

.chat-messages,
.sidebar-list {
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

.chat-messages::-webkit-scrollbar,
.sidebar-list::-webkit-scrollbar {
  width: 8px;
}

.chat-messages::-webkit-scrollbar-thumb,
.sidebar-list::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 999px;
}

/* ---------- Message bubbles ---------- */

.bubble-row {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  max-width: 820px;
  width: 100%;
  margin: 0 auto;
}

.bubble-row.bot {
  justify-content: flex-start;
}

.bubble-row.user {
  justify-content: flex-end;
}

.bubble-row.enter {
  animation: bubble-in 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes bubble-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .bubble-row.enter {
    animation: none;
  }
}

.avatar {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.avatar-bot {
  background: var(--accent-grad);
  color: white;
  box-shadow: 0 2px 10px rgba(124, 108, 240, 0.35);
}

.avatar-user {
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--text-dim);
}

.bubble {
  max-width: 74%;
  padding: 12px 16px;
  border-radius: var(--radius-md);
  line-height: 1.5;
  font-size: 14.5px;
}

.bubble.bot {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  color: var(--text);
  border-bottom-left-radius: 4px;
}

.bubble.user {
  background: var(--accent-grad);
  color: white;
  border-bottom-right-radius: 4px;
  box-shadow: 0 4px 16px rgba(124, 108, 240, 0.25);
}

.bubble-line {
  margin: 0 0 4px;
}

.bubble-line:last-child {
  margin-bottom: 0;
}

.bubble-spacer {
  height: 6px;
}

.bubble-bullet {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin: 3px 0;
}

.bubble-bullet-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.55;
  margin-top: 7px;
  flex-shrink: 0;
}

.typing-bubble {
  padding: 14px 18px;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 4px;
}

.typing-dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--text-dim);
  animation: typing-bounce 1.1s ease-in-out infinite;
}

.typing-dots span:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-dots span:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes typing-bounce {
  0%,
  60%,
  100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  30% {
    transform: translateY(-4px);
    opacity: 1;
  }
}

/* ---------- Scroll-to-bottom pill ---------- */

.scroll-bottom-button {
  position: absolute;
  bottom: 96px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 999px;
  padding: 7px 16px;
  font-size: 12.5px;
  font-weight: 500;
  cursor: pointer;
  box-shadow: var(--shadow-soft);
  animation: bubble-in 0.2s ease both;
  z-index: 5;
}

/* ---------- Error + listening banners ---------- */

.chat-error {
  max-width: 820px;
  width: calc(100% - 36px);
  margin: 0 auto 10px;
  padding: 10px 14px;
  background: var(--danger-bg);
  color: var(--danger);
  border: 1px solid rgba(255, 107, 107, 0.25);
  border-radius: var(--radius-sm);
  font-size: 13px;
  animation: bubble-in 0.2s ease both;
}

.chat-error.subtle {
  background: transparent;
  border-color: transparent;
  color: var(--text-faint);
  padding-top: 0;
}

.listening-banner {
  max-width: 820px;
  width: calc(100% - 36px);
  margin: 0 auto 10px;
  padding: 9px 14px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 13px;
  color: var(--text-dim);
  display: flex;
  align-items: center;
  gap: 10px;
  animation: bubble-in 0.2s ease both;
}

.listening-pulse {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--danger);
  flex-shrink: 0;
  animation: pulse-dot-red 1.2s ease-in-out infinite;
}

@keyframes pulse-dot-red {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(255, 107, 107, 0.35);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(255, 107, 107, 0);
  }
}

/* ---------- Composer ---------- */

.chat-input-row {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  padding: 14px 18px 20px;
  max-width: 860px;
  width: 100%;
  margin: 0 auto;
}

.chat-input-row textarea {
  flex: 1;
  resize: none;
  padding: 12px 16px;
  border-radius: 20px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  font-size: 14.5px;
  font-family: inherit;
  line-height: 1.4;
  max-height: 140px;
  outline: none;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.chat-input-row textarea:focus {
  border-color: var(--accent-1);
  box-shadow: 0 0 0 3px rgba(124, 108, 240, 0.15);
}

.chat-input-row textarea:disabled {
  opacity: 0.6;
}

.send-button {
  background: var(--accent-grad);
  color: white;
  border: none;
  border-radius: 50%;
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 15px;
  transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease, opacity 0.15s ease;
}

.send-button:hover:not(:disabled) {
  transform: translateY(-1px) scale(1.04);
  box-shadow: var(--shadow-glow);
  filter: brightness(1.08);
}

.send-button:active:not(:disabled) {
  transform: scale(0.96);
}

.send-button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  box-shadow: none;
}

.send-icon {
  transform: translateX(-1px);
}

.mic-button {
  position: relative;
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: 50%;
  width: 42px;
  height: 42px;
  font-size: 16px;
  cursor: pointer;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}

.mic-button:hover:not(:disabled) {
  background: var(--surface-hover);
}

.mic-button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.mic-button.listening {
  background: var(--danger);
  border-color: var(--danger);
  color: white;
}

.mic-button.mic-error {
  border-color: rgba(255, 107, 107, 0.5);
}

.mic-icon {
  position: relative;
  z-index: 1;
}

.mic-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1.5px solid var(--danger);
  opacity: 0;
  animation: mic-ripple 1.6s ease-out infinite;
}

.mic-ring-2 {
  animation-delay: 0.5s;
}

@keyframes mic-ripple {
  0% {
    transform: scale(1);
    opacity: 0.55;
  }
  100% {
    transform: scale(1.9);
    opacity: 0;
  }
}

/* ---------- Small screens ---------- */

@media (max-width: 640px) {
  .bubble {
    max-width: 84%;
  }
  .chat-header {
    padding: 14px 14px;
  }
  .chat-input-row {
    padding: 12px 12px 16px;
  }
}
