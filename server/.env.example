# Port the backend listens on
PORT=4000

# Current Kaggle Gradio public URL (changes every time the Kaggle session is
# relaunched — see README "The one thing you'll need to update per demo").
# Example: https://cff90291d86699018f.gradio.live
GRADIO_BASE_URL=

# Optional. If unset (or unreachable), the server falls back to an in-memory
# conversation store automatically.
MONGO_URI=

# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGIN=http://localhost:5173
